,"itemType":"Spell","category":"Spell","wiki":"https://dragonwilds.runescape.wiki/w/Surge","pageid":4735,"weight":null,"stacklimit":null,"repaircost":null,"catalogue":null,"description":"Channel arcane power into your dodges, travelling further and evading longer as a result.","stats":null,"icon":"https://rudeboy.dev/dragonwilds-crafting-atlas/icons/Surge.png_dd0bb"},"position":{"x":27768,"y":0}},{"selected":false,"data":{"id":"Confuse","name":"Confuse","shared_name":"Confuse","kind":"spell","itemType":"Spell","category":"Spell","wiki":"https://dragonwilds.runescape.wiki/w/Confuse","pageid":4740,"weight":null,"stacklimit":null,"repaircost":null,"catalogue":null,"description":"Twist the minds of lesser enemies, making them unable to distinguish between friend and foe for a limited time.","stats":null,"icon":"https://rudeboy.dev/dragonwilds-crafting-atlas/icons/Confuse.png_2710c"},"position":{"x":27846,"y":0}},{"selected":false,"data":{"id":"Snare","name":"Snare","shared_name":"Snare","kind":"spell","itemType":"Spell","category":"Spell","wiki":"https://dragonwilds.runescape.wiki/w/Snare","pageid":5952,"weight":null,"stacklimit":null,"repaircost":null,"catalogue":null,"description":"Conjure Earth Magic at your feet and lay a trap for your enemies! Those caught inside become rooted in place for a short time.","stats":null,"icon":"https://rudeboy.dev/dragonwilds-crafting-atlas/icons/Snare.png_6f91a"},"position":{"x":27924,"y":0}},{"selected":false,"data":{"id":"Spectral Arrows","name":"Spectral Arrows","shared_name":"Spectral Arrows","kind":"spell","itemType":"Spell","category":"Spell","wiki":"https://dragonwilds.runescape.wiki/w/Spectral_Arrows","pageid":5958,"weight":null,"stacklimit":null,"repaircost":null,"catalogue":null,"description":"Enchant your equipped bow with astral magic, causing arrows to penetrate multiple targets.","stats":null,"icon":"https://rudeboy.dev/dragonwilds-crafting-atlas/icons/Spectral_Arrows.png_e8243"},"position":{"x":28002,"y":0}},{"selected":false,"data":{"id":"Humidify","name":"Humidify","shared_name":"Humidify","kind":"spell","itemType":"Spell","category":"Spell","wiki":"https://dragonwilds.runescape.wiki/w/Humidify","pageid":8684,"weight":null,"stacklimit":null,"repaircost":null,"catalogue":null,"description":"Conjure Water magic to create a rain cloud that travels forward, instantly watering any Farming Plot that it passes over with Clean Water.","stats":null,"icon":"https://rudeboy.dev/dragonwilds-crafting-atlas/icons/Humidify.png_a061d"},"position":{"x":28080,"y":0}},{"selected":false,"data":{"id":"Uproot","name":"Uproot","shared_name":"Uproot","kind":"spell","itemType":"Spell","category":"Spell","wiki":"https://dragonwilds.runescape.wiki/w/Uproot","pageid":8708,"weight":null,"stacklimit":null,"repaircost":null,"catalogue":null,"description":"Channelling the power of the earth, summon a spectral surge that gently coaxes ripe plants from the soil. Within a small radius, all fully grown crops and wild plants are instantly harvested and drawn towards you.","stats":null,"icon":"https://rudeboy.dev/dragonwilds-crafting-atlas/icons/Uproot.png_d7bb4"},"position":{"x":28158,"y":0}},{"selected":false,"data":{"id":"Runes To Rune Essence","name":"Runes To Rune Essence","shared_name":"Runes To Rune Essence","kind":"spell","itemType":"Spell","category":"Spell","wiki":"https://dragonwilds.runescape.wiki/w/Runes_To_Rune_Essence","pageid":12231,"weight":null,"stacklimit":null,"repaircost":null,"catalogue":null,"description":"Too many runes of the wrong type and no essence around? Throw your runes on the ground and this spell will draw out their magic, leaving you with 40% of the rune essence.","stats":null,"icon":"https://rudeboy.dev/dragonwilds-crafting-atlas/icons/Runes_To_Rune_Essence.png_421d4"},"position":{"x":28236,"y":0}},{"selected":false,"data":{"id":"Summon Elemental Spirits","name":"Summon Elemental Spirits","shared_name":"Summon Elemental Spirits","kind":"spell","itemType":"Spell","category":"Spell"